file(GLOB_RECURSE inputs LIST_DIRECTORIES false "${SOURCE_DIR}/src/*.cpp" "${SOURCE_DIR}/src/*.h")
list(APPEND inputs "${SOURCE_DIR}/CMakeLists.txt")
list(SORT inputs)
set(manifest "")
foreach(input IN LISTS inputs)
  file(SHA256 "${input}" digest)
  file(RELATIVE_PATH relative "${SOURCE_DIR}" "${input}")
  string(APPEND manifest "${relative}:${digest}\n")
endforeach()
string(SHA256 source_hash "${manifest}")
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
                OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE)
execute_process(COMMAND git status --porcelain WORKING_DIRECTORY "${SOURCE_DIR}"
                OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE)
if(dirty)
  string(APPEND revision "+dirty")
endif()
set(content "#pragma once\n#define JOBS_PERF_REVISION \"${revision}\"\n#define JOBS_SOURCE_SHA256 \"${source_hash}\"\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
endif()
if(NOT content STREQUAL previous)
  file(WRITE "${OUTPUT}" "${content}")
endif()
