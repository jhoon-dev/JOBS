* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
# XER is a byte-preserved tabular interchange fixture; trailing empty cells are data.
*.xer -text -whitespace
# Generated validation evidence retains tool-emitted spacing and blank EOF lines.
docs/validation/**/*.log text eol=lf -whitespace
docs/validation/**/CMakeCache.txt text eol=lf -whitespace
# Compatibility golden bytes must be identical on every checkout platform.
tests/fixtures/enum-compat/*.jobs -text
*.nsi text eol=lf
# Preserve upstream license bytes and their recorded hashes.
packaging/licenses/** -text -whitespace
