option(JOBS_ENABLE_SANITIZERS "Instrument JOBS with ASan and UBSan (Clang, Linux/macOS)" OFF)
option(JOBS_BUILD_FUZZERS "Build Clang/libFuzzer parser tools; requires sanitizers" OFF)
if(JOBS_ENABLE_SANITIZERS OR JOBS_BUILD_FUZZERS)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(Clang|AppleClang)$" OR WIN32)
    message(FATAL_ERROR "JOBS runtime checking requires Clang on Linux/macOS; normal Release builds need neither option")
  endif()
  if(JOBS_BUILD_FUZZERS AND NOT JOBS_ENABLE_SANITIZERS)
    message(FATAL_ERROR "JOBS_BUILD_FUZZERS requires JOBS_ENABLE_SANITIZERS=ON")
  endif()
  add_compile_options(-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
  add_link_options(-fsanitize=address,undefined -fno-sanitize-recover=all)
endif()
